# Django Secret Key (generate a strong random string in production)
SECRET_KEY=django-insecure-production-secret-key-change-me

# Set to False in production
DEBUG=False

# Comma-separated allowed hosts (include your Render URL, e.g. .onrender.com)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database Connection (Option 1: Complete Connection URL - Railway, Aiven, TiDB Cloud)
# Format: mysql://user:password@host:port/dbname
DATABASE_URL=mysql://root:password@localhost:3306/cricket_analytics

# Database Connection (Option 2: Individual variables)
DB_NAME=cricket_analytics
DB_USER=root
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=3306

# CORS Configuration (Set your deployed Vercel frontend URL)
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
